<Window x:Class="NetworkPacketAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NetworkPacketAnalyzer"
        xmlns:vm="clr-namespace:NetworkPacketAnalyzer.ViewModels"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="Network Packet Analyzer" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:ProtocolToColorConverter x:Key="ProtocolToColor"/>
        <local:ProtocolToBrushConverter x:Key="ProtocolToBrush"/>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..." Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Save As..." Command="{Binding SaveFileCommand}" InputGestureText="Ctrl+S"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="ApplicationCommands.Close"/>
            </MenuItem>
            <MenuItem Header="_Capture">
                <MenuItem Header="_Start" Command="{Binding StartCaptureCommand}"/>
                <MenuItem Header="_Stop" Command="{Binding StopCaptureCommand}"/>
                <Separator/>
                <MenuItem Header="_Refresh Interfaces" Command="{Binding RefreshDevicesCommand}"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Statistics" IsCheckable="True" IsChecked="{Binding ShowStatisticsPanel}"/>
                <MenuItem Header="_TCP Streams" IsCheckable="True" IsChecked="{Binding ShowStreamsPanel}"/>
                <MenuItem Header="ARP _Alerts" IsCheckable="True" IsChecked="{Binding ShowAlertsPanel}"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Command="{Binding StartCaptureCommand}" ToolTip="Start Capture">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M0,0 L8,4 L0,8 Z" Fill="Green" Width="12" Height="12"/>
                        <TextBlock Text="Start" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding StopCaptureCommand}" ToolTip="Stop Capture">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Fill="Red" Width="12" Height="12"/>
                        <TextBlock Text="Stop" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <Button Command="{Binding OpenFileCommand}" ToolTip="Open PCAP File">
                    <TextBlock Text="Open" Margin="8,0"/>
                </Button>
                <Button Command="{Binding SaveFileCommand}" ToolTip="Save PCAP File">
                    <TextBlock Text="Save" Margin="8,0"/>
                </Button>
                <Separator/>
                <Button Command="{Binding ClearPacketsCommand}" ToolTip="Clear All Packets">
                    <TextBlock Text="Clear" Margin="8,0"/>
                </Button>
                <Separator/>
                <ComboBox Width="250" ItemsSource="{Binding AvailableDevices}"
                          SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="Description"/>
                <Button Command="{Binding RefreshDevicesCommand}" ToolTip="Refresh Interfaces" Margin="4,0">
                    <TextBlock Text="Refresh" Margin="4,0"/>
                </Button>
                <Separator/>
                <Button Name="StatisticsButton" Click="StatisticsButton_Click" ToolTip="Toggle Statistics Panel">
                    <TextBlock Text="Statistics" Margin="4,0"/>
                </Button>
                <Button Name="StreamsButton" Click="StreamsButton_Click" ToolTip="Toggle TCP Streams Panel">
                    <TextBlock Text="Streams" Margin="4,0"/>
                </Button>
                <Button Name="AlertsButton" Click="AlertsButton_Click" ToolTip="Toggle ARP Alerts Panel">
                    <TextBlock Text="Alerts" Margin="4,0"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- Filter Bar -->
        <DockPanel DockPanel.Dock="Top" Margin="5,5,5,0">
            <TextBlock Text="Filter: " VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBox Name="FilterTextBox"
                     ToolTip="e.g., ip.src==192.168.1.1, protocol==TCP, tcp.port==80"
                     KeyDown="FilterTextBox_KeyDown"/>
            <Button Content="Apply" Click="ApplyButton_Click" Width="60" Margin="5,0,0,0" DockPanel.Dock="Right"/>
            <Button Content="Clear" Click="ClearButton_Click" Width="60" Margin="5,0" DockPanel.Dock="Right"/>
        </DockPanel>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="Packets: "/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding TotalPackets}" FontWeight="Bold"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="Filtered: "/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding FilteredCount}" FontWeight="Bold" Foreground="Blue"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Statistics Panel (Right side) -->
        <DockPanel DockPanel.Dock="Right" Width="380" Visibility="{Binding ShowStatisticsPanel, Converter={StaticResource BoolToVisibility}}">
            <GridSplitter Width="5" HorizontalAlignment="Left" Background="#D0D0D0"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Protocol Distribution" FontWeight="Bold"
                               Background="#E0E0E0" Padding="5"/>
                    <lvc:PieChart Series="{Binding ProtocolPieSeries}"
                                  Height="250"
                                  MinHeight="200"
                                  LegendPosition="Bottom"
                                  TooltipPosition="Top"
                                  InitialRotation="-90"/>

                    <TextBlock Text="Packet Rate (Packets/sec)" FontWeight="Bold"
                               Background="#E0E0E0" Padding="5"/>
                    <lvc:CartesianChart Series="{Binding PacketRateSeries}"
                                         XAxes="{Binding XAxisRate}"
                                         YAxes="{Binding YAxisRate}"
                                         Height="220"
                                         MinHeight="180"
                                         LegendPosition="Top"
                                         Margin="0,0,0,5"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- TCP Streams Panel -->
        <DockPanel DockPanel.Dock="Right" Width="300" Visibility="{Binding ShowStreamsPanel, Converter={StaticResource BoolToVisibility}}">
            <GridSplitter Width="5" HorizontalAlignment="Left" Background="#D0D0D0"/>
            <DockPanel>
                <TextBlock Text="TCP Streams" DockPanel.Dock="Top" FontWeight="Bold"
                           Background="#E0E0E0" Padding="5"/>
                <ListBox ItemsSource="{Binding Streams}"
                         DisplayMemberPath="DisplayName"
                         SelectedItem="{Binding SelectedStream}"/>
            </DockPanel>
        </DockPanel>

        <!-- ARP Alerts Panel -->
        <DockPanel DockPanel.Dock="Right" Width="300" Visibility="{Binding ShowAlertsPanel, Converter={StaticResource BoolToVisibility}}">
            <GridSplitter Width="5" HorizontalAlignment="Left" Background="#D0D0D0"/>
            <DockPanel>
                <TextBlock Text="ARP Spoofing Alerts" DockPanel.Dock="Top" FontWeight="Bold"
                           Background="#FFE0E0" Foreground="Red" Padding="5"/>
                <ListBox ItemsSource="{Binding ArpAlerts}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding IpDisplay}" FontWeight="Bold" Foreground="Red"/>
                                <TextBlock Text="{Binding MacsDisplay}" FontSize="10"/>
                                <TextBlock Text="{Binding Count}" FontSize="10"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </DockPanel>

        <!-- Main Content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Packet List -->
            <DataGrid Name="PacketGrid" ItemsSource="{Binding FilteredPackets}"
                      SelectedItem="{Binding SelectedPacket}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.IsDeferredScrollingEnabled="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="60"/>
                    <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" Width="110"/>
                    <DataGridTextColumn Header="Source" Binding="{Binding SourceIpDisplay}" Width="130"/>
                    <DataGridTextColumn Header="Destination" Binding="{Binding DestinationIpDisplay}" Width="130"/>
                    <DataGridTextColumn Header="Protocol" Binding="{Binding ProtocolDisplay}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{Binding Protocol, Converter={StaticResource ProtocolToBrush}}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Length" Binding="{Binding LengthDisplay}" Width="80"/>
                    <DataGridTextColumn Header="Info" Binding="{Binding Info}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Grid Splitter -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#D0D0D0"/>

            <!-- Details & Hex Panel -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Packet Details TreeView -->
                <TreeView Name="DetailsTree" ItemsSource="{Binding SelectedPacket.Details}"
                          Background="#F5F5F5" BorderThickness="1">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                <TextBlock Text=": "/>
                                <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="#D0D0D0"/>

                <!-- Hex View -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                              Background="#F5F5F5" BorderThickness="1" BorderBrush="#888">
                    <ItemsControl ItemsSource="{Binding HexLines}"
                                  TextElement.FontFamily="Consolas"
                                  TextElement.FontSize="12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextOptions.TextFormattingMode="Display"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
